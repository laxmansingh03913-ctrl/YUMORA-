# ===================================================
# YOUMIKA ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# 1. APPLICATION & SITE URL
# ---------------------------------------------------
# Local Development:
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
#
# Production:
# NEXT_PUBLIC_SITE_URL="https://youmika.site"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-jwt-secret-key"

# 2. SUPABASE BACKEND AUTH & DATABASE
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://rwqzuigozagzgioixpgn.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Transaction mode pooler for runtime / Vercel (IPv4-ready)
DATABASE_URL="postgresql://postgres.rwqzuigozagzgioixpgn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session mode direct connection for migrations
DIRECT_URL="postgresql://postgres.rwqzuigozagzgioixpgn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# 3. GOOGLE OAUTH CREDENTIALS (Configured in Supabase Auth & Google Cloud Console)
# ---------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. EMAIL DELIVERY SERVICE (RESEND API)
# ---------------------------------------------------
# Get your API key from https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Youmika <notifications@youmika.site>"

# 5. SERVER-SIDE MASTER ADMIN AUTHORIZATION
# ---------------------------------------------------
# Kept server-side to prevent exposing authorization rules to client bundles
ADMIN_EMAIL="megwansiabhishek7@gmail.com"
ADMIN_SECRET_KEY="your_secure_admin_api_secret_key"

# 6. RAZORPAY PAYMENT GATEWAY (UPI, GPay, PhonePe, Cards)
# ---------------------------------------------------
# Get API keys from https://dashboard.razorpay.com (Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
