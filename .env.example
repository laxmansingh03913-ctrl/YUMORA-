# ===================================================
# YUMORA ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# 1. APPLICATION & SITE URL (CRITICAL FOR OAUTH)
# ---------------------------------------------------
# Local Development:
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
#
# Production (Vercel Deployment):
# NEXT_PUBLIC_SITE_URL="https://yumora-eight.vercel.app"
#
# Production (Custom Domain - when connected):
# NEXT_PUBLIC_SITE_URL="https://yumora.io"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Legacy / Server-side URL fallbacks (Preserved for compatibility)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-jwt-secret-key"

# 2. SUPABASE BACKEND AUTH & DATABASE
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://rwqzuigozagzgioixpgn.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Transaction mode pooler for runtime / Vercel (IPv4-ready)
DATABASE_URL="postgresql://postgres.rwqzuigozagzgioixpgn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session mode direct connection for migrations
DIRECT_URL="postgresql://postgres.rwqzuigozagzgioixpgn:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# 3. GOOGLE OAUTH CREDENTIALS (Configured in Supabase Auth & Google Cloud Console)
# ---------------------------------------------------
# Client ID is safe for server/config, Client Secret MUST ONLY be configured in Supabase dashboard / server env
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. EMAIL DELIVERY SERVICE (RESEND API)
# ---------------------------------------------------
# Get your API key from https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="Yomika <notifications@youmika.site>"

