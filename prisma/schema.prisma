// Prisma schema for Yumora - Global Novel & Comics Creator Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  READER
  CREATOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ONGOING
  COMPLETED
  HIATUS
}

enum ContentRating {
  EVERYONE
  TEEN
  MATURE
}

enum ContentType {
  NOVEL
  COMIC
  ANIMATION
}

model User {
  id             String          @id
  name           String
  username       String          @unique
  email          String          @unique
  role           Role            @default(CREATOR)
  avatar         String?
  banner         String?
  bio            String?
  country        String?         @default("Global")
  website        String?
  twitter        String?
  isVerified     Boolean         @default(false) @map("is_verified")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  preferredTypes String[]        @default([]) @map("preferred_types")
  primaryGenres  String[]        @default([]) @map("primary_genres")

  novels         Novel[]
  comics         Comic[]
  comments       Comment[]
  likes          Like[]
  bookmarks      Bookmark[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  contestSubmissions ContestSubmission[]
  readingProgress ReadingProgress[]

  followers      Follow[]        @relation("UserFollowers")
  following      Follow[]        @relation("UserFollowing")
  transactions   Transaction[]
  wallet         CoinWallet?
  payoutRequests PayoutRequest[]
  reportsFiled   Report[]

  @@index([username])
  @@index([email])
  @@map("profiles")
}

model Follow {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Novel {
  id             String          @id @default(dbgenerated("gen_random_uuid()"))
  creatorId      String          @map("creator_id")
  title          String
  slug           String          @unique
  description    String          @db.Text
  coverUrl       String          @map("cover_url")
  bannerUrl      String?         @map("banner_url")
  genre          String
  secondaryGenre String?         @map("secondary_genre")
  tags           String[]        @default([])
  language       String          @default("en")
  format         String?         @default("STANDARD")
  subType        String?         @default("WEB_NOVEL")
  status         ContentStatus   @default(ONGOING)
  contentRating  ContentRating   @default(TEEN) @map("content_rating")
  views          Int             @default(0)
  reads          Int             @default(0)
  rating         Float           @default(5.0)
  totalRatings   Int             @default(0) @map("total_ratings")
  isFeatured     Boolean         @default(false) @map("is_featured")
  isEditorPick   Boolean         @default(false) @map("is_editor_pick")
  isPremium      Boolean         @default(false) @map("is_premium")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  chapters       Chapter[]

  @@index([slug])
  @@index([genre])
  @@index([language])
  @@index([creatorId])
  @@index([status])
  @@map("novels")
}

model Chapter {
  id            String        @id @default(dbgenerated("gen_random_uuid()"))
  novelId       String        @map("novel_id")
  chapterNumber Int           @map("chapter_number")
  title         String
  content       String        @db.Text
  status        ContentStatus @default(ONGOING)
  wordCount     Int           @default(0) @map("word_count")
  isFree        Boolean       @default(true) @map("is_free")
  publishedAt   DateTime      @default(now()) @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  novel         Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, chapterNumber])
  @@index([novelId])
  @@map("chapters")
}

model Comic {
  id            String        @id @default(dbgenerated("gen_random_uuid()"))
  creatorId     String        @map("creator_id")
  title         String
  slug          String        @unique
  description   String        @db.Text
  coverUrl      String        @map("cover_url")
  bannerUrl     String?       @map("banner_url")
  genre         String
  tags          String[]      @default([])
  language      String        @default("en")
  status        ContentStatus @default(ONGOING)
  contentRating ContentRating @default(TEEN) @map("content_rating")
  views          Int             @default(0)
  reads          Int             @default(0)
  rating         Float           @default(5.0)
  totalRatings  Int             @default(0) @map("total_ratings")
  isFeatured    Boolean         @default(false) @map("is_featured")
  isEditorPick  Boolean         @default(false) @map("is_editor_pick")
  isPremium     Boolean         @default(false) @map("is_premium")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  creator       User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  episodes      ComicEpisode[]

  @@index([slug])
  @@index([genre])
  @@index([creatorId])
  @@map("comics")
}

model ComicEpisode {
  id            String        @id @default(dbgenerated("gen_random_uuid()"))
  comicId       String        @map("comic_id")
  episodeNumber Int           @map("episode_number")
  title         String
  thumbnailUrl  String?       @map("thumbnail_url")
  imageUrls     String[]      @default([]) @map("image_urls")
  status        ContentStatus @default(ONGOING)
  publishedAt   DateTime      @default(now()) @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  comic         Comic         @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([comicId, episodeNumber])
  @@index([comicId])
  @@map("episodes")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @map("user_id")
  content   String   @db.Text
  novelId   String?  @map("novel_id")
  chapterId String?  @map("chapter_id")
  comicId   String?  @map("comic_id")
  episodeId String?  @map("episode_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("comments")
}

model Like {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @map("user_id")
  targetId   String   @map("target_id")
  targetType String   @default("STORY") @map("target_type")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @map("user_id")
  novelId   String?  @map("novel_id")
  comicId   String?  @map("comic_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bookmarks")
}

model ReadingProgress {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  userId        String   @map("user_id")
  contentId     String   @map("content_id")
  contentType   String   @default("NOVEL") @map("content_type")
  chapterNumber Int?     @map("chapter_number")
  episodeNumber Int?     @map("episode_number")
  scrollOffset  Float    @default(0.0) @map("scroll_offset")
  pageIndex     Int      @default(0) @map("page_index")
  lastReadAt    DateTime @default(now()) @map("last_read_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("reading_progress")
}

model CoinWallet {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  userId      String   @unique @map("user_id")
  balance     Int      @default(0)
  totalEarned Int      @default(0) @map("total_earned")
  totalSpent  Int      @default(0) @map("total_spent")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_wallets")
}

model Transaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  userId     String   @map("user_id")
  orderId    String   @map("order_id")
  paymentId  String   @unique @map("payment_id")
  packageId  String   @map("package_id")
  amountInr  Float    @map("amount_inr")
  coinsAdded Int      @map("coins_credited")
  status     String   @default("COMPLETED")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model PayoutRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  userId            String    @map("user_id")
  amountInr         Float     @map("amount_inr")
  amountUsd         Float?    @map("amount_usd")
  method            String    @default("UPI")
  details           String    @db.Text
  accountHolderName String?   @map("account_holder_name")
  status            String    @default("PENDING")
  referenceId       String?   @map("reference_id")
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  processedAt       DateTime? @map("processed_at")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payout_requests")
}

model Contest {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  title          String
  slug           String   @unique
  subtitle       String?
  description    String?  @db.Text
  bannerUrl      String?  @map("banner_url")
  prizePool      String?  @map("prize_pool")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  status         String   @default("LIVE")
  rules          String[] @default([])
  eligibleGenres String[] @default([]) @map("eligible_genres")
  minChapters    Int      @default(2) @map("min_chapters")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  submissions    ContestSubmission[]

  @@index([slug])
  @@map("contests")
}

model Report {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  reporterId  String    @map("reporter_id")
  contentId   String    @map("content_id")
  contentType String    @default("NOVEL") @map("content_type")
  reason      String
  description String?   @db.Text
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  reporter    User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model CommunityPost {
  id        String             @id @default(dbgenerated("gen_random_uuid()"))
  userId    String             @map("user_id")
  category  String
  title     String
  content   String             @db.Text
  tags      String[]           @default([])
  upvotes   Int                @default(0)
  views     Int                @default(0)
  isPinned  Boolean            @default(false) @map("is_pinned")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  CommunityComment[]

  @@map("community_posts")
}

model CommunityComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  text      String   @db.Text
  upvotes   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_comments")
}

